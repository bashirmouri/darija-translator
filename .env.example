# Server configuration (read by MicroProfile Config from environment variables).
# Open Liberty does NOT read this file. Copy the values you need into
# server/src/main/liberty/config/server.env (gitignored) or export them in your shell.

# LLM provider: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=
# A current Flash model from Google AI Studio
GEMINI_MODEL=

# Ollama (local model, optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Basic Auth credentials accepted by the service
APP_USERNAME=
APP_PASSWORD=
