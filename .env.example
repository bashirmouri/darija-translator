# Server configuration (read by MicroProfile Config from environment variables).
# Open Liberty does NOT read this file. Copy the values you need into
# server/src/main/liberty/config/server.env (gitignored) or export them in your shell.
# Write plain values: no quotes, no < >, no spaces around "=", and (on Windows) no "!" or non-ASCII characters.

# LLM provider. Only "gemini" is implemented.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio) - required
GEMINI_API_KEY=
# Exact model name from Google AI Studio, without "models/" (e.g. a current Flash or Flash-Lite model)
GEMINI_MODEL=

# Reserved for an optional local Ollama provider (not implemented; ignored by the server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Basic Auth credentials accepted by the service - required
APP_USERNAME=
APP_PASSWORD=
